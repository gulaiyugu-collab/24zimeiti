# Supabase project endpoint (public project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Temporary private-preview gate. Set a strong password on Render before deploy.
PROJECT024_ACCESS_USERNAME=project024
PROJECT024_ACCESS_PASSWORD=replace_with_a_long_random_password

# Safe for browser-side clients when RLS is enabled.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secret. Never put this in frontend code, Git, screenshots, or chat.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Cloud control plane settings
PROJECT024_CLOUD_CONTROL_BASE_URL=https://your-control-plane.example
PROJECT024_CLOUD_WORKER_ID=worker-01
PROJECT024_CLOUD_WORKER_TOKEN=replace_me

# Local processing root for the outbound Worker
PROJECT024_ACQUISITION_ROOT=G:\\Project024Data\\acquisition
