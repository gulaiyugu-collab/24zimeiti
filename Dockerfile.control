FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-cloud-control.txt .
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-cloud-control.txt \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY 工作文件/app/app ./app
COPY 工作文件/app/static ./static

USER app

EXPOSE 8787

CMD ["sh", "-c", "test -n \"$SUPABASE_URL\" || { echo 'SUPABASE_URL is required'; exit 1; }; test -n \"$SUPABASE_SECRET_KEY\" || { echo 'SUPABASE_SECRET_KEY is required'; exit 1; }; test -n \"$PROJECT024_CLOUD_WORKER_TOKEN\" || { echo 'PROJECT024_CLOUD_WORKER_TOKEN is required'; exit 1; }; exec uvicorn app.services.cloud_control_plane:app --host 0.0.0.0 --port ${PORT:-8787}"]
